# Copia este archivo a `.env` y ajusta los valores.
# `.env` está en .gitignore y nunca debe commitearse.

# Obligatoria en producción. En desarrollo hay un valor inseguro por defecto.
DJANGO_SECRET_KEY=change-me

# Hosts permitidos, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Cadena de conexión de la base de datos.
# Desarrollo: sqlite:///db.sqlite3
# Producción: postgres://usuario:password@host:5432/nombre
DATABASE_URL=sqlite:///db.sqlite3

# Solo producción (envío de correo).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
